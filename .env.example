# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Model to use. Free-tier options: https://ai.google.dev/gemini-api/docs/models
MODEL=gemini-3.6-flash

# Tried in order if the model above keeps failing after retries (comma-separated, optional)
FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# Hard cap on model requests for one run. The loop only calls the model when a
# disruption is actually announced, so 20 is plenty for a full demo.
LLM_REQUEST_BUDGET=20